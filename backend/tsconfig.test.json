{
  // Typechecks the test suite too. Separate from tsconfig.json because that
  // one sets rootDir: "src" for the build output, which tests/ sits outside of.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // tests/render/ reaches into the Next app's renderer, which imports its
    // types through the app's own "@/" alias.
    "paths": { "@/*": ["../*"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
